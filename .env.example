# Copy this file to .env before running `docker compose up`.
# .env is gitignored on purpose - never commit real secrets, even course-fake ones.
# (This habit is deliberate: Module 8 covers config/secrets, and the point starts here.)

# --- Postgres ---
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=pipeline_pass_local_only
POSTGRES_DB=warehouse
POSTGRES_PORT=5432

# --- Mock API: core behavior ---
MOCK_API_PORT=8000
RANDOM_SEED=42
RECORDS_PER_DAY=537
PAGE_SIZE=50

# --- Mock API: flakiness knobs ---
# Fraction (0.0-1.0) of records that come back malformed
MALFORMED_RATE=0.03

# Rate limiting: max requests allowed per rolling window
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=10

# Timeouts: fraction of requests that hang, and how long they hang for
TIMEOUT_RATE=0.05
TIMEOUT_HANG_SECONDS=12

# Pagination chaos: which page number gets duplicated / returned empty.
# Set either to 0 to disable that specific behavior.
DUPLICATE_PAGE_NUMBER=3
EMPTY_PAGE_NUMBER=0
